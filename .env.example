# A-Bau Website — Umgebungsvariablen (NUR Platzhalter, KEINE echten Werte!)
# Echte Werte liegen AUSSCHLIESSLICH in: /etc/nexifyai/hermes.env (Host) bzw.
# /home/hermeswebui/.hermes/.env (Container-Spiegel). Nie Werte ins Repo!

# 9Router (LLM-Gateway für Chat) — Pflicht für /api/chat
CUSTOM_API_KEY=<9Router-API-Key>
# DEEPSEEK_API_KEY=<nicht verwenden — Direkt-Key bricht 9Router-Auth>

# SMTP (Hostinger, Kontaktformular-Versand) — Pflicht für /api/contact
SMTP_HOST=<smtp-host>
SMTP_PORT=465
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>

# Kontakt-Empfänger (Default: kontakt@a-bau.info)
ABAU_CONTACT_TO=kontakt@a-bau.info

# Server-Port (Default: 8095)
PORT=8095
