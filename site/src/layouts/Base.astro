---
import { kontakt, siteMeta } from '../lib/data.ts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import ChatWidget from '../components/ChatWidget.astro';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  url?: string;
  ogImage?: string;
  noindex?: boolean;
  breadcrumb?: { name: string; path: string }[];
  schema?: object | object[];
}

const {
  title,
  description = '',
  url = '/',
  ogImage,
  noindex = false,
  breadcrumb = [],
  schema,
} = Astro.props as Props;

const site = 'https://a-bau.nexifyai.cloud';
const fullTitle = title.includes('A-Bau') ? title : `${title} – A-Bau Meisterbetrieb GmbH`;
const defaultOgImage = siteMeta?.site?.og_bild;
const resolvedOgImage = ogImage ?? defaultOgImage;
const schemas = Array.isArray(schema) ? schema : schema ? [schema] : [];
const breadcrumbSchema: object[] = [];

// LocalBusiness / LocalService — JSON-LD (Schema.org), nur verifizierte Daten aus kontakt.yaml
const k = kontakt as any;
const openingHoursSpec = (k.kontakt?.oeffnungszeiten ?? []).map((o: any) => {
  const dayMap: Record<string, string[]> = {
    'Mo–Do': ['Monday', 'Tuesday', 'Wednesday', 'Thursday'],
    'Fr':    ['Friday'],
    'Sa':    ['Saturday'],
    'So':    ['Sunday'],
  };
  const days = dayMap[o.tage] ?? [];
  if (!days.length || o.zeiten === 'geschlossen') return null;
  // Unterstützt Trennzeichen: en-dash (–, U+2013) und Bindestrich (-, U+002D)
  const [opens, closes] = (o.zeiten as string).split(/[–\-]/);
  if (!opens || !closes) return null;
  return days.map(day => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: `https://schema.org/${day}`,
    opens: opens?.trim(),
    closes: closes?.trim(),
  }));
}).filter(Boolean).flat();

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
  name:            k.firma?.name,
  legalName:       k.firma?.name,
  description:     'Bauunternehmen und Meisterbetrieb in Mönchengladbach: Denkmalrestaurierung, Innenausbau, Krankenhausbau, Schlüsselfertigbau, Sanierung, Installationen und europaweite Transporte.',
  url:             site,
  telephone:       k.kontakt?.telefon?.[0]?.nummer,
  email:           k.kontakt?.email?.[0]?.adresse,
  address: {
    '@type':           'PostalAddress',
    streetAddress:     k.adresse?.strasse,
    addressLocality:   k.adresse?.ort,
    postalCode:        k.adresse?.plz,
    addressRegion:     k.adresse?.bundesland,
    addressCountry:    'DE',
  },
  geo: {
    '@type':     'GeoCoordinates',
    // Koordinaten Luisental 69, 41199 Mönchengladbach-Geistenbeck (OSM-verifiziert)
    latitude:    51.1780,
    longitude:   6.3960,
  },
  areaServed: (k.region?.area_served ?? []).map((a: string) => ({
    // Generischer Typ da area_served auch Bundesländer (z. B. "NRW") enthält
    '@type': 'AdministrativeArea',
    name:    a,
  })),
  openingHoursSpecification: openingHoursSpec,
  legalIdentifier: `${k.firma?.register?.amtsgericht} ${k.firma?.register?.hrb}`,
  foundingDate:    k.firma?.gruendung,
  priceRange:      'Auf Anfrage',
};
if (breadcrumb.length) {
  const items = [
    { '@type': 'ListItem', position: 1, name: 'Start', item: `${site}/` },
    ...breadcrumb.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: b.name,
      item: `${site}${b.path}`,
    })),
  ];
  breadcrumbSchema.push({ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: items });
}
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(url, site).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="A-Bau Meisterbetrieb GmbH" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(url, site).href} />
    <meta property="og:locale" content="de_DE" />
    {resolvedOgImage && <meta property="og:image" content={new URL(resolvedOgImage, site).href} />}
    {resolvedOgImage && <meta property="og:image:width" content="1200" />}
    {resolvedOgImage && <meta property="og:image:height" content="1600" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {resolvedOgImage && <meta name="twitter:image" content={new URL(resolvedOgImage, site).href} />}
    <meta name="theme-color" content="#A4501F" />
    <link rel="preload" href="/fonts/Outfit-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Manrope-var.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {schemas.map(s => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {breadcrumbSchema.map(s => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <ChatWidget />
  </body>
</html>
