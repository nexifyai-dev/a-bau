---
import Base from '../layouts/Base.astro';
---

<Base
  title="Seite nicht gefunden (404)"
  description="Die angeforderte Seite wurde nicht gefunden."
  noindex
>
  <section class="section" style="text-align:center">
    <div class="container" style="max-width:560px">
      <p style="font-size:5rem;font-weight:800;font-family:var(--font-head);color:var(--accent);margin:0">404</p>
      <h1>Seite nicht gefunden</h1>
      <p>
        Die von Ihnen aufgerufene Seite existiert nicht oder wurde verschoben.
        Nutzen Sie die Navigation oder kehren Sie zur Startseite zurück.
      </p>
      <div class="hero-actions" style="justify-content:center;margin-top:var(--space-5)">
        <a class="btn btn-primary" href="/">Zur Startseite</a>
        <a class="btn btn-ghost" href="/kontakt/">Kontakt</a>
      </div>
    </div>
  </section>
</Base>
