---
import { kontakt, leistungen, faq } from '../lib/data.ts';
import Base from '../layouts/Base.astro';

// Hero-Bild: Denkmalrestaurierung
import imgHero    from '../assets/img/94.jpeg';
import imgAbout   from '../assets/img/130.jpg';
import imgRef1    from '../assets/img/72.jpeg';
import imgRef2    from '../assets/img/149.jpg';
import imgRef3    from '../assets/img/35.jpg';

const processSteps = [
  {
    number: '01',
    title: 'Erstkontakt & unverbindliche Besichtigung',
    text: 'Nennen Sie uns kurz Ihr Vorhaben – wir melden uns zeitnah für einen unverbindlichen Termin und eine Besichtigung.',
  },
  {
    number: '02',
    title: 'Transparentes Angebot',
    text: 'Nach Besichtigung erhalten Sie ein transparentes Angebot mit Leistungsbeschreibung.',
  },
  {
    number: '03',
    title: 'Ausführung durch unseren Meisterbetrieb',
    text: 'Die Ausführung erfolgt mit fester Ansprechperson; bei größeren Vorhaben erhalten Sie eine laufende Projektdokumentation.',
  },
  {
    number: '04',
    title: 'Übergabe & Gewährleistung',
    text: 'Nach der Übergabe betreuen wir Projekte weiter; Bauleistungen unterliegen den gesetzlichen Gewährleistungsregelungen.',
  },
];

const testimonial = kontakt.reputation.find((entry: any) => entry.portal === '11880.com') ?? kontakt.reputation[0];
const testimonialDate = testimonial?.datum
  ? new Date(testimonial.datum).toLocaleDateString('de-DE', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
    })
  : '';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.faq.slice(0, 8).map((f: any) => ({
    '@type': 'Question',
    name: f.frage,
    acceptedAnswer: { '@type': 'Answer', text: f.antwort },
  })),
};

// Leistungs-Icons (Unicode, kein externes CDN)
const leistungIcons: Record<string, string> = {
  denkmalrestaurierung: '🏛',
  innenausbau:          '🪟',
  krankenhausbau:       '🏥',
  schluesselfertigbau:  '🏗',
  installationen:       '⚡',
  sanierung:            '🔧',
  transporte:           '🚐',
};
---

<Base
  title="Bauunternehmen Mönchengladbach – A-Bau Meisterbetrieb"
  description="A-Bau Meisterbetrieb GmbH ist Ihr Bauunternehmen in Mönchengladbach für Denkmalrestaurierung, Innenausbau, Krankenhausbau und Schlüsselfertigbau in NRW."
  schema={faqSchema}
>

  <!-- =====================================================
       HERO — Vollbild, emotional, Inhalt führt
       ===================================================== -->
  <section class="hero" aria-label="Einführung">
    <div class="hero-media" aria-hidden="true">
      <img
        src={imgHero.src}
        alt=""
        width={1600}
        height={900}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero-inner">
      <div class="hero-content">
        <span class="hero-kicker">Meisterbetrieb · Mönchengladbach &amp; NRW</span>
        <h1>Mit Vertrauen bauen –<br>mit Qualität leben</h1>
        <p class="lead">
          Wir bauen, bewahren und gestalten. Von der Restaurierung denkmalgeschützter
          Bauten bis zum schlüsselfertigen Neubau — mit Erfahrung, Präzision
          und einem starken Team.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary btn-lg" href="/kontakt/">Projekt unverbindlich anfragen</a>
          <a class="btn btn-ghost btn-lg"   href="/leistungen/">Leistungen entdecken</a>
        </div>
      </div>
    </div>
  </section>


  <!-- =====================================================
       TRUST-BAR — echte Firmendaten
       ===================================================== -->
  <div class="trust-bar" aria-label="Unternehmens-Eckdaten">
    <div class="container">
      <div class="trust-item">
        <span class="t-ico" aria-hidden="true">🏅</span>
        <div>
          <div class="t-title">Meisterbetrieb GmbH</div>
          <div class="t-sub">eingetragener Handwerksbetrieb</div>
        </div>
      </div>
      <div class="trust-item">
        <span class="t-ico" aria-hidden="true">📋</span>
        <div>
          <div class="t-title">HRB 18836</div>
          <div class="t-sub">Amtsgericht Mönchengladbach</div>
        </div>
      </div>
      <div class="trust-item">
        <span class="t-ico" aria-hidden="true">⭐</span>
        <div>
          <div class="t-title">5 / 5 auf 11880.com</div>
          <div class="t-sub">zuverlässig · präzise · qualitätsbewusst</div>
        </div>
      </div>
      <div class="trust-item">
        <span class="t-ico" aria-hidden="true">🕐</span>
        <div>
          <div class="t-title">{kontakt.kontakt.oeffnungszeiten[0].tage} {kontakt.kontakt.oeffnungszeiten[0].zeiten}</div>
          <div class="t-sub">Mönchengladbach &amp; NRW</div>
        </div>
      </div>
    </div>
  </div>


  <!-- =====================================================
       LEISTUNGEN — Bildkarten-Grid
       ===================================================== -->
  <section class="section" aria-labelledby="leistungen-heading">
    <div class="container">
      <header class="section-head">
        <span class="kicker">Leistungen</span>
        <h2 id="leistungen-heading">Fachgerechte Bauleistungen von A-Bau</h2>
        <p>
          Von sensiblen Restaurationen bis zum schlüsselfertigen Neubau:
          unser Meisterbetrieb begleitet Sie bei jedem Bauvorhaben —
          zuverlässig, handwerklich präzise.
        </p>
      </header>
      <div class="card-grid">
        {leistungen.leistungen.map((l: any) => (
          <article class="card">
            <div class="card-body">
              <span class="card-icon" aria-hidden="true">{leistungIcons[l.slug] ?? '◆'}</span>
              <h3>{l.titel}</h3>
              <p>{l.kurz}</p>
              <a class="card-link" href={`/leistungen/${l.slug}/`}>
                Mehr erfahren <span class="arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>


  <!-- =====================================================
       SO ARBEITEN WIR — Prozess in 4 Schritten
       ===================================================== -->
  <section class="section" aria-labelledby="prozess-heading">
    <div class="container">
      <header class="section-head">
        <span class="kicker">So arbeiten wir</span>
        <h2 id="prozess-heading">Klarer Ablauf für Ihr Bauvorhaben</h2>
        <p>
          Von der ersten Anfrage bis zur Übergabe: Unser Ablauf orientiert sich an
          den Informationen aus FAQ, Angebot und Projektbetreuung.
        </p>
      </header>
      <ol class="card-grid process-grid">
        {processSteps.map((step) => (
          <li class="card card-plain process-step">
            <span class="badge process-step-number">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>


  <!-- =====================================================
       ÜBER UNS — Split-Sektion
       ===================================================== -->
  <section class="section bg-soft" aria-labelledby="about-heading">
    <div class="container">
      <div class="split">
        <div>
          <span class="kicker">Über uns</span>
          <h2 id="about-heading">Handwerk mit Geschichte und Zukunft</h2>
          <p>
            Die A-Bau Meisterbetrieb GmbH steht seit 2019 für handwerkliche Qualität
            und persönliche Betreuung. Unser Schwerpunkt ist die Restaurierung und
            Erhaltung historischer Bauwerke — mit modernen Techniken und tiefer
            Kenntnis der Originalsubstanz.
          </p>
          <p>
            Darüber hinaus realisieren wir Innenausbauten, schlüsselfertige Neubauten,
            Krankenhausbau und europaweite Direkttransporte. Jedes Projekt wird von
            Geschäftsführer Albert Pfeiffer persönlich begleitet.
          </p>
          <a class="btn btn-ghost mt-5" href="/ueber-uns/">Mehr über uns</a>
        </div>
        <div class="media-frame">
          <img
            src={imgAbout.src}
            alt="Hochwertiger Innenausbau – A-Bau Meisterbetrieb GmbH"
            width={900}
            height={675}
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>


  <!-- =====================================================
       REFERENZEN — Karten-Streifen
       ===================================================== -->
  <section class="section bg-elev" aria-labelledby="referenzen-heading">
    <div class="container">
      <header class="section-head">
        <span class="kicker">Referenzen</span>
        <h2 id="referenzen-heading">Projekte, die für Qualität sprechen</h2>
        <p>Einblicke in Denkmalrestaurierung, Innenausbau, Neubau und Badsanierung.</p>
      </header>
      <div class="card-grid">
        <a class="card" href="/referenzen/">
          <div class="card-img">
            <img
              src={imgRef1.src}
              alt="Denkmalrestaurierung – historische Fassade"
              width={640} height={400} loading="lazy"
            />
          </div>
          <div class="card-body">
            <h3>Denkmalrestaurierung</h3>
            <p>Fassaden, Stuck und Innenräume denkmalgeschützter Gebäude.</p>
            <span class="card-link">Galerie ansehen <span class="arrow" aria-hidden="true">→</span></span>
          </div>
        </a>
        <a class="card" href="/referenzen/">
          <div class="card-img">
            <img
              src={imgRef2.src}
              alt="Modernisiertes Badezimmer mit hochwertigen Fliesen"
              width={640} height={400} loading="lazy"
            />
          </div>
          <div class="card-body">
            <h3>Badezimmer &amp; Sanitär</h3>
            <p>Badmodernisierungen, Fliesen und Sanitärinstallationen.</p>
            <span class="card-link">Galerie ansehen <span class="arrow" aria-hidden="true">→</span></span>
          </div>
        </a>
        <a class="card" href="/referenzen/">
          <div class="card-img">
            <img
              src={imgRef3.src}
              alt="Neubau und schlüsselfertige Übergabe"
              width={640} height={400} loading="lazy"
            />
          </div>
          <div class="card-body">
            <h3>Neubau &amp; Schlüsselfertig</h3>
            <p>Neubauten vom Fundament bis zur schlüsselfertigen Übergabe.</p>
            <span class="card-link">Galerie ansehen <span class="arrow" aria-hidden="true">→</span></span>
          </div>
        </a>
      </div>
      <p class="text-3 ref-notice">
        Konkrete Projektdaten werden nach Kundenfreigabe ergänzt.
      </p>
    </div>
  </section>


  <!-- =====================================================
       TESTIMONIAL — echte 11880-Bewertung
       ===================================================== -->
  {testimonial && (
    <section class="section bg-soft" aria-labelledby="testimonial-heading">
      <div class="container">
        <header class="section-head">
          <span class="kicker">Das sagen Kunden</span>
          <h2 id="testimonial-heading">Vertrauen aus echten Bewertungen</h2>
          <p>
            Wir zeigen hier ausschließlich die vorhandene Bewertung aus dem Eintrag auf 11880.com.
          </p>
        </header>
        <article class="card card-plain">
          <span class="badge">11880.com · {testimonial.wert}</span>
          <p class="lead" style="margin:18px 0 12px">„{testimonial.text}“</p>
          <p class="text-3" style="margin:0">
            Quelle: {testimonial.portal}{testimonialDate ? ` · Bewertung vom ${testimonialDate}` : ''}
          </p>
        </article>
      </div>
    </section>
  )}


  <!-- =====================================================
       Stadtteile — GAG-Quartiere-Äquivalent
       ===================================================== -->
  <section class="section bg-soft" aria-labelledby="stadtteile-heading">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Stadtteile &amp; Quartiere</span>
        <h2 id="stadtteile-heading">A-Bau in Mönchengladbach</h2>
        <p>
          Mönchengladbach ist die Stadt von Borussia — und wir bauen hier für die Menschen, die leben,
          feiern und arbeiten. Von Geistenbeck bis Rheydt: Denkmalrestaurierung, Sanierung, Neubau
          und Innenausbau in allen Quartieren.
        </p>
      </div>
      <div class="card-grid">
        <a class="card" href="/stadtteile/">
          <div class="card-body">
            <h3>Unsere Stadtteile</h3>
            <p>Geistenbeck · City · Eicken · Rheydt · Odenkirchen · Niers-Umfeld — Überblick, Schwerpunkte, lokale Projekte.</p>
            <span class="card-link">Stadtteile entdecken <span class="arrow" aria-hidden="true">→</span></span>
          </div>
        </a>
        <a class="card" href="/stadtteile/#baustellen">
          <div class="card-body">
            <h3>Baustellen in Mönchengladbach</h3>
            <p>Aktuelle Baumaßnahmen der Stadt, mags und NEW — verlinkt zu den offiziellen Quellen.</p>
            <span class="card-link">Aktuelle Baustellen <span class="arrow" aria-hidden="true">→</span></span>
          </div>
        </a>
        <a class="card" href="/referenzen/">
          <div class="card-body">
            <h3>Lokale Projekte</h3>
            <p>Referenzen aus Mönchengladbach: Denkmalrestaurierung, Gesundheitsbau, Innenausbau, Neubau.</p>
            <span class="card-link">Projekte ansehen <span class="arrow" aria-hidden="true">→</span></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- =====================================================
       FAQ — Split-Teaser + Accordion
       ===================================================== -->
  <section class="section" aria-labelledby="faq-heading">
    <div class="container">
      <div class="split">
        <div>
          <span class="kicker">FAQ</span>
          <h2 id="faq-heading">Häufige Fragen – kurz beantwortet</h2>
          <p>
            Ob Ablauf, Gewährleistung oder Einsatzgebiet: hier finden Sie
            die wichtigsten Antworten. Ihre Frage ist nicht dabei?
            Sprechen Sie uns direkt an.
          </p>
          <a class="btn btn-ghost mt-5" href="/faq/">Alle Fragen ansehen</a>
        </div>
        <div class="accordion" data-accordion>
          {faq.faq.slice(0, 4).map((f: any) => (
            <div class="acc-item">
              <button class="acc-btn" type="button" aria-expanded="false">
                {f.frage}
                <span class="chev" aria-hidden="true">▾</span>
              </button>
              <div class="acc-panel">
                <div class="acc-panel-inner"><p>{f.antwort}</p></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- =====================================================
       CTA-BAND — finaler Aufruf
       ===================================================== -->
  <section class="cta-band" aria-labelledby="cta-heading">
    <div class="container">
      <span class="kicker cta-kicker">Jetzt starten</span>
      <h2 id="cta-heading">Ihr Projekt – unser Handwerk</h2>
      <p>
        Beschreiben Sie uns Ihr Vorhaben — wir melden uns zeitnah
        für einen unverbindlichen Termin.
      </p>
      <div class="cta-actions">
        <a class="btn btn-lg btn-inv" href="/kontakt/">Projekt unverbindlich anfragen</a>
        <a class="btn btn-ghost btn-lg" href="/leistungen/">Leistungen ansehen</a>
      </div>
    </div>
  </section>

</Base>

<script>
  // FAQ-Accordion (Spring via CSS-Transition, aria-expanded)
  document.querySelectorAll('[data-accordion]').forEach(root => {
    root.querySelectorAll('.acc-item').forEach(item => {
      const btn   = item.querySelector('.acc-btn')   as HTMLButtonElement;
      const panel = item.querySelector('.acc-panel') as HTMLElement;
      // Initialer Zustand: geschlossen
      panel.style.display = 'none';
      btn.addEventListener('click', () => {
        const open = item.classList.contains('open');
        // Alle schließen
        root.querySelectorAll('.acc-item.open').forEach(o => {
          o.classList.remove('open');
          (o.querySelector('.acc-btn') as HTMLButtonElement).setAttribute('aria-expanded', 'false');
          (o.querySelector('.acc-panel') as HTMLElement).style.display = 'none';
        });
        if (!open) {
          item.classList.add('open');
          btn.setAttribute('aria-expanded', 'true');
          panel.style.display = 'block';
        }
      });
    });
  });
</script>
