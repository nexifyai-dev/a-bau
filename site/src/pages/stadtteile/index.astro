---
import Base from '../../layouts/Base.astro';
import { stadtteile } from '../../lib/data.ts';

const s = stadtteile.stadt;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: s.quartiere.map((q, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Place',
      name: q.name,
      description: q.text,
      address: { '@type': 'PostalAddress', addressLocality: 'Mönchengladbach', addressCountry: 'DE' },
    },
  })),
};
---

<Base
  title="Stadtteile & Quartiere – A-Bau Meisterbetrieb Mönchengladbach"
  description="A-Bau in Mönchengladbach: Denkmalrestaurierung, Sanierung und Neubau in allen Stadtteilen — Geistenbeck, Eicken, Rheydt, City und mehr. Verlinkungen zu aktuellen Baumaßnahmen der Stadt."
  breadcrumb={[{ name: 'Stadtteile', path: '/stadtteile/' }]}
  schema={schema}
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">{s.titel}</span>
        <h1>Stadtteile &amp; Quartiere in Mönchengladbach</h1>
        <p>{s.intro}</p>
        <p class="text-3">{s.borussia_note}</p>
      </div>

      <div class="card-grid" style="margin-top:var(--space-6)">
        {s.quartiere.map(q => (
          <article class="card">
            <div class="card-body">
              <h3>{q.name}</h3>
              <p>{q.text}</p>
              <p class="text-3" style="font-size:.9rem"><strong>Schwerpunkt:</strong> {q.schwerpunkt}</p>
              <a class="card-link" href="/kontakt/">Projekt in diesem Stadtteil anfragen <span class="arrow" aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>

      <section class="section" style="background:var(--bg-soft);border-radius:var(--r-lg);padding:var(--space-7);margin-top:var(--space-7)">
        <span class="kicker">Stadt-Info</span>
        <h2 id="baustellen">Aktuelle Baustellen &amp; Baumaßnahmen in Mönchengladbach</h2>
        <p>
          Wir arbeiten im Kontext der Stadt — und verlinken Sie direkt zu den offiziellen Quellen.
          Alle Links sind extern und tagesaktuell.
        </p>
        <ul class="baustellen-links">
          {s.baustellen_links.map(l => (
            <li><a href={l.url} target="_blank" rel="noopener noreferrer">{l.titel}</a></li>
          ))}
        </ul>
        <p class="text-3" style="font-size:.88rem;margin-top:var(--space-4)">
          A-Bau übernimmt Bauvorhaben in allen Stadtteilen Mönchengladbachs — von Geistenbeck über Eicken bis Rheydt.
          Bei Fragen zu einem konkreten Projekt hilft das <a href="/kontakt/">Kontaktformular</a>.
        </p>
      </section>
    </div>
  </section>
</Base>
