---
import { kontakt } from '../lib/data.ts';
import Base from '../layouts/Base.astro';
---

---

<Base
  title="Kontakt – A-Bau Meisterbetrieb GmbH"
  description="Kontakt zur A-Bau Meisterbetrieb GmbH: Luisental 69, 41199 Mönchengladbach. Telefon (02166) 9925056 oder 0162 18 15 229, E-Mail kontakt@a-bau.info. Vereinbaren Sie einen unverbindlichen Termin."
  breadcrumb={[{ name: 'Kontakt', path: '/kontakt/' }]}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Kontakt – A-Bau Meisterbetrieb GmbH',
    url: 'https://a-bau.nexifyai.cloud/kontakt/',
  }}
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="kicker">Kontakt</span>
        <h1>Sprechen Sie uns an</h1>
        <p>
          Beschreiben Sie uns kurz Ihr Vorhaben – wir melden uns zeitnah für einen
          unverbindlichen Termin und ein transparentes Angebot.
        </p>
      </div>

      <div class="split">
        <div>
          <form id="contact-form" class="form-grid" novalidate>
            <div class="form-field">
              <label for="cf-name">Name *</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" maxlength="120" required />
            </div>
            <div class="form-field">
              <label for="cf-email">E-Mail *</label>
              <input id="cf-email" name="email" type="email" autocomplete="email" maxlength="160" required />
            </div>
            <div class="form-field">
              <label for="cf-phone">Telefon (optional)</label>
              <input id="cf-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" />
            </div>
            <div class="form-field">
              <label for="cf-subject">Betreff *</label>
              <select id="cf-subject" name="subject" required>
                <option value="">Bitte wählen …</option>
                <option>Denkmalrestaurierung</option>
                <option>Innenausbau</option>
                <option>Krankenhausbau</option>
                <option>Schlüsselfertigbau / Neubau</option>
                <option>Installationen Strom &amp; Wasser</option>
                <option>Sanierung / Altbau</option>
                <option>Transport</option>
                <option>Sonstiges</option>
              </select>
            </div>
            <div class="form-field full">
              <label for="cf-message">Ihr Anliegen *</label>
              <textarea id="cf-message" name="message" maxlength="3000" required></textarea>
            </div>
            <div class="form-field full">
              <label style="display:flex;gap:var(--space-2);align-items:flex-start;font-weight:500">
                <input type="checkbox" id="cf-consent" name="consent" required style="width:auto;min-height:0;margin-top:2px" />
                <span>Ich willige ein, dass meine Angaben zur Bearbeitung der Anfrage verarbeitet werden (Art. 6 Abs. 1 lit. b DSGVO). Details: <a href="/datenschutz/">Datenschutzerklärung</a>. *</span>
              </label>
            </div>
            <div class="form-field full hp-field" aria-hidden="true">
              <label for="cf-website">Website</label>
              <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <div class="form-field full">
              <p class="form-error" id="cf-error" role="alert" hidden></p>
              <p class="form-success" id="cf-success" role="status" hidden></p>
            </div>
            <div class="form-field full">
              <button class="btn btn-primary btn-lg" type="submit">Nachricht senden</button>
            </div>
          </form>
        </div>

        <div>
          <div class="card" style="margin-bottom:var(--space-4)">
            <h3>Anschrift</h3>
            <address style="font-style:normal;color:var(--text-2)">
              {kontakt.firma.name}<br />
              {kontakt.adresse.strasse}<br />
              {kontakt.adresse.plz} {kontakt.adresse.ort} ({kontakt.adresse.ortsteil})
            </address>
          </div>
          <div class="card" style="margin-bottom:var(--space-4)">
            <h3>Telefon &amp; E-Mail</h3>
            <ul style="list-style:none;padding:0;margin:0;display:grid;gap:var(--space-2)">
              {kontakt.kontakt.telefon.map(t => (
                <li><a href={`tel:${t.nummer.replace(/[^+\d]/g, '')}`}>{t.display}</a> <span style="color:var(--text-3);font-size:0.85rem">({t.label})</span></li>
              ))}
              {kontakt.kontakt.email.map(e => (
                <li><a href={`mailto:${e.adresse}`}>{e.adresse}</a></li>
              ))}
            </ul>
          </div>
          <div class="card">
            <h3>Öffnungszeiten</h3>
            <ul style="list-style:none;padding:0;margin:0;display:grid;gap:var(--space-1)">
              {kontakt.kontakt.oeffnungszeiten.map(o => (
                <li style="display:flex;justify-content:space-between;color:var(--text-2)">
                  <span>{o.tage}</span><span>{o.zeiten}</span>
                </li>
              ))}
            </ul>
            <p style="color:var(--text-3);font-size:0.8rem;margin-top:var(--space-3);margin-bottom:0">
              Termine außerhalb der Öffnungszeiten nach Vereinbarung.
            </p>
          </div>
        </div>
      </div>

      <div class="notice" style="margin-top:var(--space-6)">
        <strong>Anfahrt:</strong> Luisental 69, 41199 Mönchengladbach (Geistenbeck). Parkplätze
        direkt am Objekt. Karte (OpenStreetMap, ohne Tracking) folgt nach Deploy-Konfiguration.
      </div>
    </div>
  </section>
</Base>

<script>
  // Formular: serverseitige Validierung am /api/contact (Trust-Boundary), Honeypot,
  // Rate-Limit serverseitig, keine PII in Logs.
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const errEl = document.getElementById('cf-error') as HTMLElement;
  const okEl = document.getElementById('cf-success') as HTMLElement;
  const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

  form.addEventListener('submit', async e => {
    e.preventDefault();
    errEl.hidden = true;
    okEl.hidden = true;

    // Client-Validierung (UX), echte Validierung am Server
    const fd = new FormData(form);
    const name = String(fd.get('name') || '').trim();
    const email = String(fd.get('email') || '').trim();
    const subject = String(fd.get('subject') || '').trim();
    const message = String(fd.get('message') || '').trim();
    const consent = fd.get('consent') === 'on';
    if (!name || !email || !subject || !message) {
      errEl.textContent = 'Bitte füllen Sie alle Pflichtfelder aus.';
      errEl.hidden = false;
      return;
    }
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
      errEl.textContent = 'Bitte geben Sie eine gültige E-Mail-Adresse an.';
      errEl.hidden = false;
      return;
    }
    if (!consent) {
      errEl.textContent = 'Bitte stimmen Sie der Verarbeitung Ihrer Daten zu.';
      errEl.hidden = false;
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Wird gesendet …';
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, phone: String(fd.get('phone') || '').trim(), subject, message, website: String(fd.get('website') || '').trim() }),
      });
      const data = await res.json().catch(() => null);
      if (res.ok && data?.status === 'ok') {
        form.reset();
        okEl.textContent = 'Vielen Dank! Ihre Nachricht ist eingegangen. Wir melden uns zeitnah.';
        okEl.hidden = false;
      } else {
        errEl.textContent = data?.error || 'Leider ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut oder rufen Sie uns an.';
        errEl.hidden = false;
      }
    } catch {
      errEl.textContent = 'Leider ist ein Fehler aufgetreten. Bitte versuchen Sie es erneut oder rufen Sie uns an.';
      errEl.hidden = false;
    } finally {
      btn.disabled = false;
      btn.textContent = 'Nachricht senden';
    }
  });
</script>
