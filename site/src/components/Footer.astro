---
import { kontakt } from '../lib/data.ts';
import Logo from './Logo.astro';

const k = kontakt as any;
const firma      = k.firma?.name    ?? 'A-Bau Meisterbetrieb GmbH';
const strasse    = k.adresse?.strasse ?? 'Luisental 69';
const plz        = k.adresse?.plz     ?? '41199';
const ort        = k.adresse?.ort     ?? 'Mönchengladbach';
const hrb        = k.firma?.register?.hrb ?? 'HRB 18836';
const amtsgericht= k.firma?.register?.amtsgericht ?? 'Amtsgericht Mönchengladbach';

const telefonEintraege = k.kontakt?.telefon ?? [];
const emailEintraege   = k.kontakt?.email   ?? [];
const festnetz  = telefonEintraege.find((t: any) => t.label === 'Festnetz') ?? telefonEintraege[0];
const mobil     = telefonEintraege.find((t: any) => t.label === 'Mobil');
const email = emailEintraege[0]?.adresse ?? 'kontakt@a-bau.info';

const zeiten = k.kontakt?.oeffnungszeiten ?? [
  { tage: 'Mo–Do', zeiten: '08:00–17:00' },
  { tage: 'Fr',    zeiten: '07:00–17:00' },
  { tage: 'Sa',    zeiten: '08:00–13:00' },
  { tage: 'So',    zeiten: 'geschlossen' },
];

const navLinks = [
  { href: '/',               label: 'Start'           },
  { href: '/leistungen/',    label: 'Leistungen'      },
  { href: '/referenzen/',    label: 'Referenzen'      },
  { href: '/ueber-uns/',     label: 'Über uns'        },
  { href: '/faq/',           label: 'FAQ'             },
  { href: '/kontakt/',       label: 'Kontakt'         },
];

const jahr = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-grid">

      <!-- Spalte 1: Marke -->
      <div class="footer-col-brand">
        <Logo height={38} variant="dark" class="footer-logo" />
        <p>
          Restaurierung denkmalgeschützter Bauten, Innenausbau, Schlüsselfertigbau,
          Sanierung und Installationen — aus Mönchengladbach für ganz NRW.
        </p>
      </div>

      <!-- Spalte 2: Navigation -->
      <div>
        <h4>Navigation</h4>
        <nav aria-label="Footer-Navigation">
          {navLinks.map(l => <a href={l.href}>{l.label}</a>)}
        </nav>
      </div>

      <!-- Spalte 3: Kontakt -->
      <div>
        <h4>Kontakt</h4>
        <nav aria-label="Kontaktinformationen">
          <span>{strasse}, {plz} {ort}</span>
          {festnetz && (
            <a href={`tel:${festnetz.nummer}`}>{festnetz.display}</a>
          )}
          {mobil && (
            <a href={`tel:${mobil.nummer}`}>{mobil.display}</a>
          )}
          <a href={`mailto:${email}`}>{email}</a>
        </nav>
      </div>

      <!-- Spalte 4: Öffnungszeiten -->
      <div>
        <h4>Öffnungszeiten</h4>
        <div class="oeff">
          {zeiten.map((z: any) => (
            <div class="oeff-row">
              <span class="oeff-label">{z.tage}</span>
              <strong>{z.zeiten}</strong>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Footer-Bottom -->
    <div class="footer-bottom">
      <span>© {jahr} {firma} · {hrb} · {amtsgericht}</span>
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
      <a href="/cookie-richtlinie/">Cookie-Richtlinie</a>
    </div>
  </div>
</footer>
