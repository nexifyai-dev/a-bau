---
const navLinks = [
  { href: '/',            label: 'Start'      },
  { href: '/leistungen/', label: 'Leistungen' },
  { href: '/referenzen/', label: 'Referenzen' },
  { href: '/ueber-uns/',  label: 'Über uns'   },
  { href: '/faq/',        label: 'FAQ'        },
];
const currentPath = Astro.url?.pathname ?? '/';
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="site-header" id="site-header">
  <div class="container">
    <div class="header-inner">
      <!-- Logo -->
      <a class="brand" href="/" aria-label="A-Bau Meisterbetrieb – Startseite">
        <img
          class="brand-logo"
          src="/logo-abau.svg"
          alt="A-Bau Meisterbetrieb"
          width="176"
          height="44"
        />
      </a>

      <!-- Desktop-Navigation -->
      <nav class="nav-desktop" aria-label="Hauptnavigation">
        {navLinks.map(l => (
          <a
            href={l.href}
            aria-current={isCurrent(l.href) ? 'page' : undefined}
          >{l.label}</a>
        ))}
        <a class="btn btn-primary nav-cta" href="/kontakt/">Angebot anfordern</a>
      </nav>

      <!-- Mobile Toggle -->
      <button
        class="nav-toggle"
        id="nav-toggle"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="drawer"
      >☰</button>
    </div>
  </div>
</header>

<!-- Mobiler Drawer -->
<nav class="drawer-panel" id="drawer" aria-hidden="true" aria-label="Mobile Navigation">
  <button class="drawer-close" aria-label="Menü schließen">✕</button>
  {navLinks.map(l => (
    <a
      href={l.href}
      aria-current={isCurrent(l.href) ? 'page' : undefined}
    >{l.label}</a>
  ))}
  <a class="btn btn-primary" href="/kontakt/">Angebot anfordern</a>
</nav>
<div class="drawer-scrim" aria-hidden="true"></div>

<script>
  const toggle  = document.getElementById('nav-toggle')  as HTMLButtonElement;
  const drawer  = document.getElementById('drawer')       as HTMLElement;
  const scrim   = document.querySelector('.drawer-scrim') as HTMLElement;
  const closeBtn= drawer.querySelector('.drawer-close')   as HTMLButtonElement;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function openDrawer() {
    drawer.style.visibility = 'visible';
    drawer.classList.add('open');
    scrim.classList.add('open');
    if (!reduced) {
      drawer.style.transition = 'transform var(--spring-duration) var(--spring-timing)';
    }
    drawer.style.transform = 'translateX(0)';
    drawer.setAttribute('aria-hidden', 'false');
    toggle.setAttribute('aria-expanded', 'true');
    const first = drawer.querySelector('a') as HTMLElement;
    first?.focus();
  }

  function closeDrawer() {
    drawer.classList.remove('open');
    scrim.classList.remove('open');
    if (!reduced) {
      drawer.style.transition = 'transform .28s cubic-bezier(.4,0,.8,.4)';
      drawer.style.transform = 'translateX(105%)';
      setTimeout(() => { drawer.style.visibility = 'hidden'; }, 300);
    } else {
      drawer.style.transform = 'translateX(105%)';
      drawer.style.visibility = 'hidden';
    }
    drawer.setAttribute('aria-hidden', 'true');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.focus();
  }

  toggle?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  scrim?.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });

  // Scroll-Schatten
  const header = document.querySelector('.site-header') as HTMLElement;
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
